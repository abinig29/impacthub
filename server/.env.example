# Server Configuration
PORT=5000
NODE_ENV=production

# Database — use MongoDB Atlas URI for production
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/impacthub?retryWrites=true&w=majority

# JWT — generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_strong_random_secret_here_minimum_32_chars

# Frontend URL (for CORS + meeting links)
CLIENT_URL=https://your-frontend.vercel.app

# Super Admin — ONLY this email gets super_admin role automatically
SUPER_ADMIN_EMAIL=fnigus33@gmail.com

# Email (optional — for verification emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_gmail_app_password
